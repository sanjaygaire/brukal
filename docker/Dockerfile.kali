# The cage: a Kali container holding the FULL professional pentest toolset, plus an
# OpenVPN client so it can reach a lab/HTB network. A new user gets everything out of
# the box — Brukal reaches for whatever a hunt needs; the operator just audits.
# Nothing executes here except commands the gate has approved and handed in via
# `docker exec`. No agent ever gets an interactive shell in this container, and every
# tool — however powerful — still runs ONLY through the gate (scope + risk + audit).
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# Which Kali metapackage defines the toolset. Default = kali-linux-headless: the
# full CLI pentest arsenal (~600 tools) built for a no-GUI environment — the correct
# shape for a container the operator never opens a screen on. Override for more:
#   --build-arg KALI_METAPACKAGE=kali-linux-large       (headless + niche long-tail;
#       NOTE: pulls in a full desktop/GUI via kali-linux-default — big, slow, unused)
#   --build-arg KALI_METAPACKAGE=kali-linux-everything  (literally everything Kali ships)
ARG KALI_METAPACKAGE=kali-linux-headless

# Cage essentials the container needs regardless of the toolset: VPN + net tooling,
# nftables (the kernel egress lock the entrypoint installs), python3 (parses
# scope.json), setcap, the headless browser for the governed web surface, and the
# wordlists the strategist proposes (seclists + rockyou) so ffuf/gobuster/hydra never
# fail on a missing wordlist file.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openvpn iproute2 iptables nftables python3 libcap2-bin ca-certificates \
        chromium seclists wordlists \
    && rm -rf /var/lib/apt/lists/*

# rockyou ships gzipped; unpack it so `-P /usr/share/wordlists/rockyou.txt` works.
RUN [ -f /usr/share/wordlists/rockyou.txt.gz ] && \
        gunzip -k /usr/share/wordlists/rockyou.txt.gz || true

# THE FULL KALI TOOLSET — nmap, ffuf, gobuster, sqlmap, hydra, nuclei, metasploit,
# crackmapexec, impacket, wpscan, john, hashcat, enum4linux-ng, responder,
# evil-winrm, and hundreds more. Recommends are kept ON PURPOSE: the metapackage
# pulls its tools through them. This is a LARGE, LONG build (several GB) — that is
# the cost of a batteries-included cage. Capability grows; the gate is unchanged.
RUN apt-get update && apt-get install -y ${KALI_METAPACKAGE} \
    && rm -rf /var/lib/apt/lists/*

# Least-privilege raw-socket scanning: grant the capability to the nmap binary ONLY,
# so SYN/service/OS scans work without privileging the whole container.
RUN setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip "$(command -v nmap)"

# Non-root user for TOOL execution. The executor runs `docker exec -u brukalop`, so
# approved tools run unprivileged. The container's main process stays root so the
# entrypoint can bring up the VPN and install the nftables egress lock (NET_ADMIN).
RUN useradd -m -s /usr/sbin/nologin brukalop

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
