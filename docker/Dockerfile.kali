# The cage: a Kali container holding the allowlisted ENUMERATION tools, plus an
# OpenVPN client so it can reach a lab/HTB network. Nothing executes here except
# commands the gate has approved and handed in via `docker exec`. No agent ever
# gets an interactive shell in this container.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# Enumeration toolset (keep in sync with scope.json -> allowlisted_tools),
# OpenVPN + iproute2 to reach the target network, and libcap2-bin for setcap.
RUN apt-get update && apt-get install -y --no-install-recommends \
        nmap gobuster ffuf feroxbuster nikto whatweb wafw00f curl wget \
        dnsutils dnsrecon sslscan \
        smbclient smbmap enum4linux nbtscan snmp onesixtyone ldap-utils redis-tools \
        openvpn iproute2 libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

# The wider offensive arsenal (brute force, web attack, cracking, exploitation
# helpers, shells). These are ALLOWLISTED, but the risk layer marks them
# irreversible, so it routes them to human sign-off (ESCALATE) or refusal (DENY)
# — see scope.htb.json + risk.py. Capability grows; the gate is unchanged.
RUN apt-get update && apt-get install -y --no-install-recommends \
        masscan dirb wfuzz nuclei dnsenum fierce \
        hydra medusa ncrack sqlmap wpscan \
        john hashcat hash-identifier exploitdb \
        crackmapexec impacket-scripts evil-winrm responder \
        netcat-traditional socat \
        chromium \
    && rm -rf /var/lib/apt/lists/*
# ^ chromium: headless browser for the governed web surface (brukal web --chrome,
#   the Chrome/CDP backend) — renders JS apps + drives interactive web actions.

# Least-privilege raw-socket scanning: grant the capability to the nmap binary
# ONLY, so SYN/service/OS scans work without privileging the whole container.
RUN setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip "$(command -v nmap)"

# Non-root user for TOOL execution. The executor runs `docker exec -u brukalop`,
# so approved tools run unprivileged. The container's main process stays root so
# the entrypoint can bring up the VPN (which needs NET_ADMIN + /dev/net/tun).
RUN useradd -m -s /usr/sbin/nologin brukalop

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
