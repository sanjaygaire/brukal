# --- Brukal runtime artifacts (never commit engagement data) ---
runs/                      # audit logs + run outputs
vault/                     # Obsidian blackboard written during a run
docker/vault/*             # cage-mounted vault + cross-session lessons (engagement data)
!docker/vault/.gitkeep
*.audit.jsonl
audit.jsonl
results*.json              # experiment-harness dumps
scope.local.json           # personal/live scope files

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / local config ---
.env
.env.*
*.key
*.pem
# HTB / lab VPN configs (may embed private keys)
docker/vpn/*.ovpn
docker/vpn/*.conf

# Local engagement output (audit logs, per-run scope files)
runs/

# --- Editor / OS cruft ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
